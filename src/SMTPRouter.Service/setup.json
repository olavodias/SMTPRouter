{

  "Hosting": {
    "Server": "localhost",
    "Path": "C:\\SMTPRouter",
    "MessageLifespan": "00:15",
    "MessagePurgeLifespan": 45,
    "RequireAuthentication": false,
    "PortsConfiguration": {
      "Default": {
        "Number": 25,
        "IsSecure": false
      },
      "Secure": {
        "Number": 587,
        "IsSecure": true
      }
    },
    "AcceptedIPAddresses": [],
    "RejectedIPAddresses": []
  },

  "Connections": {
    "Autoliv": {
      "Description": "Autoliv SMTP Server",
      "Host": "smtp.alv.autoliv.int",
      "Port": 25,
      "RequiresAuthentication": false,
      "SecureSocketOption": "0",
      "ActiveConnections": 4,
      "GroupingOption": 2
    },
    "Veoneer": {
      "Description": "Veoneer SMTP Server",
      "Host": "smtp.corp.int",
      "Port": 25,
      "RequiresAuthentication": false,
      "SecureSocketOption": "0",
      "ActiveConnections": 1,
      "GroupingOption": 2
    }
  },

  "Routing": {
    "Types": [],
    "Rules": {
      "Rule01": {
        "Type": "SMTPRouter.MailFromDomainRoutingRule, SMTPRouter",
        "Parameters": "Domain=autoliv.com",
        "ConnectionKey": "Autoliv"
      },
      "Rule02": {
        "Type": "SMTPRouter.MailFromDomainRoutingRule, SMTPRouter",
        "Parameters": "Domain=autoliv.int",
        "ConnectionKey": "Autoliv"
      }
    }
  }

}
